[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/operator/operator_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/operator/operator_menu_range_icon.gd" id="2_range"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.09, 0.13, 0.2, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.65, 1, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.2, 0.3, 0.45, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_hover"]
bg_color = Color(0.3, 0.45, 0.65, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_disabled"]
bg_color = Color(0.16, 0.18, 0.22, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="OperatorMenu" type="CanvasLayer" layer="50"]
script = ExtResource("1_menu")

[node name="CloseArea" type="Button" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
flat = true
text = ""

[node name="MenuPanel" type="PanelContainer" parent="CloseArea"]
unique_name_in_owner = true
offset_left = 100.0
offset_top = 100.0
offset_right = 100.0
offset_bottom = 100.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="CloseArea/MenuPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="NameLabel" type="Label" parent="CloseArea/MenuPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.9, 1, 1)
theme_override_font_sizes/font_size = 14
text = "干员"
horizontal_alignment = 1

[node name="SkillButton" type="Button" parent="CloseArea/MenuPanel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 26)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.8, 0.9, 1, 1)
theme_override_colors/font_disabled_color = Color(0.5, 0.5, 0.5, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/disabled = SubResource("StyleBoxFlat_btn_disabled")
text = "技能"

[node name="RetreatButton" type="Button" parent="CloseArea/MenuPanel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 26)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.8, 0.9, 1, 1)
theme_override_colors/font_disabled_color = Color(0.5, 0.5, 0.5, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/disabled = SubResource("StyleBoxFlat_btn_disabled")
text = "撤退"

[node name="RangeIcon" type="Control" parent="CloseArea/MenuPanel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(60, 45)
layout_mode = 2
script = ExtResource("2_range")

[connection signal="pressed" from="CloseArea" to="." method="_on_close_button_pressed"]
[connection signal="pressed" from="CloseArea/MenuPanel/VBox/SkillButton" to="." method="_on_skill_button_pressed"]
[connection signal="pressed" from="CloseArea/MenuPanel/VBox/RetreatButton" to="." method="_on_retreat_button_pressed"]
